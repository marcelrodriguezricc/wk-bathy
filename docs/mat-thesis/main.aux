\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Two-dimensional FFT spectra for subset 32 of the North Shore, O'ahu, Hawaii area of interest derived from SAR imagery and mapped to physical wavenumber space. Left: The magnitude of the wavenumber spectrum following FFT and centering of the DC component. Right: The same spectrum with detected high-energy spectral blobs overlaid; the two dominant features correspond to the complex conjugate pair associated with the primary swell system.}}{26}{figure.10}\protected@file@percent }
\newlabel{figure10}{{10}{26}{Two-dimensional FFT spectra for subset 32 of the North Shore, O'ahu, Hawaii area of interest derived from SAR imagery and mapped to physical wavenumber space. Left: The magnitude of the wavenumber spectrum following FFT and centering of the DC component. Right: The same spectrum with detected high-energy spectral blobs overlaid; the two dominant features correspond to the complex conjugate pair associated with the primary swell system}{figure.10}{}}
\newlabel{figure10@cref}{{[figure][10][]10}{[1][25][]26}{}{}{}}
\@writefile{toc}{\contentsline {section}{\numberline {4}Conclusion}{27}{section.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces SAR-derived depth estimates for each area of interest. Top left: Wassabo Beach, Florida, exhibits the highest density of physically plausible depth estimates and overall strongest algorithm performance. Top right: The Golden Gate region, California, retains more than half of the depth estimates after filtering, though performance degrades near the bay mouth, where increased error and bias are observed. Bottom left: The Rincón, Puerto Rico site yields no physically plausible depth estimates. Bottom right: The North Shore of O'ahu, Hawaii site produces a single plausible depth estimate.}}{28}{figure.11}\protected@file@percent }
\newlabel{figure11}{{11}{28}{SAR-derived depth estimates for each area of interest. Top left: Wassabo Beach, Florida, exhibits the highest density of physically plausible depth estimates and overall strongest algorithm performance. Top right: The Golden Gate region, California, retains more than half of the depth estimates after filtering, though performance degrades near the bay mouth, where increased error and bias are observed. Bottom left: The Rincón, Puerto Rico site yields no physically plausible depth estimates. Bottom right: The North Shore of O'ahu, Hawaii site produces a single plausible depth estimate}{figure.11}{}}
\newlabel{figure11@cref}{{[figure][11][]11}{[1][27][]28}{}{}{}}
